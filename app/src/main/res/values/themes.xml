<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark window matching the app background, so launch doesn't flash white before Compose draws. -->
    <style name="Theme.MyHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/myhub_background</item>
        <item name="android:windowSplashScreenBackground">@color/myhub_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- See-through window for the widget's quick-add sheet; Compose draws the dim scrim. -->
    <style name="Theme.MyHub.QuickAdd" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
